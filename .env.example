# Copy to .env (git-ignored). Never commit real values.

# Root for runtime data (profiles, runs). Must stay git-ignored.
HOUND_HOME=.hound

# Default to headless runs; `--headed` overrides per command.
HOUND_HEADLESS=true

# Optional: LLM key for AI-assisted tasks (e.g. Stagehand). Leave empty if unused.
ANTHROPIC_API_KEY=
