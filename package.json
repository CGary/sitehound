{
  "name": "sitehound",
  "version": "0.1.0",
  "private": true,
  "description": "Task-agnostic browser harness to explore, test, analyze and clone websites — with reusable manual-login sessions.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "hound": "node packages/cli/src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test 'tests/**/*.test.ts'",
    "browsers": "playwright install chromium",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
